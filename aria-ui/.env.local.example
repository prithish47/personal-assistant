# Copy to .env.local and fill in the values that match your backend's .env.
# Both are inlined into the client bundle at build time (NEXT_PUBLIC_* is
# always public) — fine for this fully local, single-user app.

NEXT_PUBLIC_ARIA_WS_URL=ws://127.0.0.1:8000/v1/ws
NEXT_PUBLIC_ARIA_API_KEY=replace-with-the-same-api-key-as-the-backend-.env
